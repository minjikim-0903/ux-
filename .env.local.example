# 이 파일을 .env.local로 복사해서 값을 채우세요. (.env.local은 git에 올라가지 않아요)

# Supabase — DB, 익명 로그인, 스크린샷 저장소
# 대시보드 → Project Settings → API. URL과 anon 키는 공개용이라 브라우저에서 써도 괜찮아요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 관리자 키. 모든 보안 규칙(RLS)을 건너뛰므로 서버에서만 쓰세요. NEXT_PUBLIC_를 절대 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API 키 (AI 진단용). console.anthropic.com → API 키 → "기타 위치"로 발급. 서버에서만 써요.
ANTHROPIC_API_KEY=

# Cloudflare Turnstile (CAPTCHA) — 봇이 익명 계정을 대량으로 만들어 진단을 반복하는 걸 막아요 (AI 비용 보호).
# 사람에게는 보이지 않게 확인하고, 통과 증명을 Supabase 익명 가입에 함께 보내요.
# - Site Key(공개용): 아래에 넣어요. 브라우저에서 쓰는 값이라 노출돼도 괜찮아요.
# - Secret Key(비밀용): 여기 넣지 말고 Supabase → Authentication → Attack Protection에 넣어요.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# (선택) Google Safe Browsing API 키. 있으면 악성·피싱 사이트를 진단 전에 걸러요.
GOOGLE_SAFE_BROWSING_KEY=

# (개발용) true면 AI 대신 테스트용 가짜 리포트를 만들어요. 크레딧 없이 흐름을 테스트할 때 써요. 배포 환경에서는 무시돼요.
DIAGNOSE_MOCK=false

# (개발용) true면 localhost 같은 내부 주소도 진단해요. 배포할 때는 절대 켜지 마세요.
ALLOW_PRIVATE_URLS=false
